# Twilio credentials — required for SMS notifications on new appointment requests
# On Hostinger, use TWILIO_AUTH_KEY for the auth credential name
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_KEY=your_twilio_auth_key_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX   # Your Twilio phone number

# Hostinger SMTP credentials — required for email notifications on new appointment requests
EMAIL_USER=your_hostinger_email_here
EMAIL_PASSWORD=your_hostinger_email_password_here
SMTP_FROM=Help@EmergencyDentalArkansas.com
APPOINTMENT_EMAIL_TO=Help@EmergencyDentalArkansas.com

# Server port (default: 3000)
PORT=3000
